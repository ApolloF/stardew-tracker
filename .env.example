# Generate a long random value. Required for the one-time owner setup screen.
SETUP_TOKEN=replace-with-a-long-random-setup-secret

# Optional. The app retains deterministic local advice without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Set to 1 only when a trusted reverse proxy supplies forwarding headers.
TRUST_PROXY=0
